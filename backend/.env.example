# Configurações de Ambiente - Banca no Ponto
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Configurações do Servidor
PORT=3001
NODE_ENV=development

# Configurações do Banco de Dados
DATABASE_URL="file:./prisma/dev.db"

# Configurações de Autenticação
JWT_SECRET=chave_secreta_muito_forte_aqui_mude_em_producao
JWT_EXPIRES_IN=24h

# Configurações de CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # Diário às 02:00
BACKUP_MAX_FILES=7
BACKUP_COMPRESS=true

# Configurações de Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de Upload
MAX_FILE_SIZE=5242880 # 5MB em bytes
UPLOAD_PATH=./uploads

# Configurações de Email (para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app
EMAIL_FROM=seu_email@gmail.com

# Configurações de Notificações
NOTIFICATION_ENABLED=true
NOTIFICATION_SOUND=true
NOTIFICATION_DESKTOP=true

# Configurações de Cache
CACHE_TTL=3600 # 1 hora em segundos
CACHE_MAX_SIZE=100

# Configurações de API Externa (se necessário)
EXTERNAL_API_KEY=sua_chave_api
EXTERNAL_API_URL=https://api.externa.com
