{
  "version": 2,
  "buildCommand": "cd frontend && npm ci && npm run build",
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{backend/**,frontend/build/**}",
        "excludeFiles": "{backend/node_modules/**,frontend/node_modules/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/api/index.js"
    }
  ]
}
