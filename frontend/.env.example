# Configurações de Ambiente - Frontend Banca no Ponto
# Copie este arquivo para .env e ajuste os valores conforme necessário

# URL da API Backend
REACT_APP_API_URL=http://localhost:3001/api

# Configurações de Ambiente
REACT_APP_ENV=development

# Configurações de Timeout
REACT_APP_API_TIMEOUT=10000

# Configurações de Cache
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_TTL=300000 # 5 minutos

# Configurações de Upload
REACT_APP_MAX_FILE_SIZE=5242880 # 5MB

# Configurações de Mapa (se necessário)
REACT_APP_MAPS_API_KEY=sua_chave_api

# Configurações de Analytics (se necessário)
REACT_APP_ANALYTICS_ID=seu_id_analytics

# Configurações de Debug
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=info

# Configurações de Tema
REACT_APP_THEME=light
REACT_APP_PRIMARY_COLOR=#007bff

# Configurações de Notificações
REACT_APP_NOTIFICATIONS_ENABLED=true
REACT_APP_NOTIFICATION_SOUND=true

# Configurações de Paginação
REACT_APP_DEFAULT_PAGE_SIZE=20
REACT_APP_MAX_PAGE_SIZE=100

# Configurações de Formatação
REACT_APP_CURRENCY=BRL
REACT_APP_LOCALE=pt-BR
REACT_APP_TIMEZONE=America/Sao_Paulo
